@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "HCR_R047_HF3_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:HCR_R047_HF3_SELF);$m=[regex]::Match($s,'(?ms)^#HCR_HF3_PS_BEGIN\r?\n(.*?)^#HCR_HF3_PS_END');if(-not $m.Success){throw 'Missing HF3 launcher section'};& ([scriptblock]::Create($m.Groups[1].Value))"
set "RC=%ERRORLEVEL%"
echo.
echo Exit code: %RC%
pause
exit /b %RC%
#HCR_HF3_PS_BEGIN
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding($false)
$OutputEncoding = [Console]::OutputEncoding
$env:PYTHONUTF8 = '1'
$env:PYTHONDONTWRITEBYTECODE = '1'
$code = 1
$log = $null
function Find-ExistingPython([string]$Executable, [string[]]$Prefixes) {
    $oldPreference = $ErrorActionPreference
    $found = $null
    $rc = 1
    try {
        $ErrorActionPreference = 'Continue'
        $found = & $Executable @Prefixes -c 'import sys; print(sys.executable); sys.exit(0 if sys.version_info >= (3,12) else 2)' 2>$null
        $rc = $LASTEXITCODE
    } finally { $ErrorActionPreference = $oldPreference }
    if ($rc -eq 0 -and $found) {
        $p = [string]($found | Select-Object -Last 1)
        $p = $p.Trim()
        if (Test-Path -LiteralPath $p -PathType Leaf) { return $p }
    }
    return $null
}
try {
    $self = $env:HCR_R047_HF3_SELF
    $repo = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($self))
    if (-not (Test-Path -LiteralPath (Join-Path $repo 'R047_MANIFEST.json') -PathType Leaf)) {
        throw 'Place this CMD in the existing installed R047 repository root.'
    }
    $folder = Join-Path $repo ('HCR-Evidence\deployments\r047-hf3-bootstrap-' + [Guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($folder) | Out-Null
    $log = Join-Path $folder 'bootstrap.txt'
    'R047-HF3: source and release-manifest migration' | Set-Content -LiteralPath $log -Encoding UTF8
    $scriptText = [IO.File]::ReadAllText($self)
    $payload = [regex]::Match($scriptText,'(?ms)^#HCR_HF3_PY_BEGIN\r?\n([A-Za-z0-9+/=\r\n]+)^#HCR_HF3_PY_END')
    if (-not $payload.Success) { throw 'Missing HF3 Python payload' }
    $bytes = [Convert]::FromBase64String($payload.Groups[1].Value)
    $algorithm = [Security.Cryptography.SHA256]::Create()
    try { $actual = ([BitConverter]::ToString($algorithm.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
    finally { $algorithm.Dispose() }
    if ($actual -ne 'b44b55d00a3802322b754e8b3906abacdce3c57415fd35b206442654dacf6f97') { throw 'HF3 payload checksum mismatch' }
    $patch = Join-Path $folder 'repair_r047_hf3.py'
    [IO.File]::WriteAllBytes($patch,$bytes)
    $python = $null
    if ($env:HCR_PYTHON) {
        if (-not (Test-Path -LiteralPath $env:HCR_PYTHON -PathType Leaf)) { throw 'HCR_PYTHON does not name an existing interpreter.' }
        $python = Find-ExistingPython $env:HCR_PYTHON @()
        if (-not $python) { throw 'HCR_PYTHON must be an existing Python 3.12+ interpreter.' }
    } else {
        $py = Get-Command 'py.exe' -ErrorAction SilentlyContinue
        if ($py) {
            $python = Find-ExistingPython $py.Source @('-3.12')
            if (-not $python) { $python = Find-ExistingPython $py.Source @('-3') }
        }
        foreach ($name in @('python.exe','python3.exe')) {
            if ($python) { break }
            $candidate = Get-Command $name -ErrorAction SilentlyContinue
            if ($candidate -and $candidate.Source.IndexOf('\WindowsApps\',[StringComparison]::OrdinalIgnoreCase) -lt 0) {
                $python = Find-ExistingPython $candidate.Source @()
            }
        }
    }
    if (-not $python) { throw 'No existing Python 3.12+ found. Nothing was installed or downloaded.' }
    ('Python: ' + $python) | Add-Content -LiteralPath $log -Encoding UTF8
    Write-Host ('Python: ' + $python)
    Write-Host 'R047-HF3: verifying authorized patch state, full release inventory and copied source snapshot.'
    & $python -X utf8 -B $patch --repo $repo
    $code = $LASTEXITCODE
    if ($null -eq $code) { $code = 1 }
    ('exit_code=' + $code) | Add-Content -LiteralPath $log -Encoding UTF8
} catch {
    $message = 'ERROR: ' + $_.Exception.Message
    Write-Host $message
    if ($log) { ($_ | Out-String) | Add-Content -LiteralPath $log -Encoding UTF8 }
    $code = 1
}
exit $code
#HCR_HF3_PS_END

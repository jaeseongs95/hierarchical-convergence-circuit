@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "HCR_R049_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:HCR_R049_SELF);$m=[regex]::Match($s,'(?ms)^#HCR_PS_BEGIN\r?\n(.*?)^#HCR_PS_END');if(-not $m.Success){throw 'Missing launcher'};& ([scriptblock]::Create($m.Groups[1].Value))"
set "RC=%ERRORLEVEL%"
echo.
echo Exit code: %RC%
pause
exit /b %RC%
#HCR_PS_BEGIN
$ErrorActionPreference='Stop'
[Console]::OutputEncoding=New-Object Text.UTF8Encoding($false)
$code=1
$journal=$null
try {
    $self=$env:HCR_R049_SELF
    $repo=[IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($self))
    if(-not(Test-Path -LiteralPath (Join-Path $repo 'src\hcr') -PathType Container)) {
        throw 'Place this CMD in the existing HCR repository root.'
    }
    $journal=Join-Path $repo ('HCR-Evidence\deployments\r049-bootstrap-'+[Guid]::NewGuid().ToString('N').Substring(0,12))
    [IO.Directory]::CreateDirectory($journal)|Out-Null
    Write-Host 'HCR R049 / EXP30: top-down x initialization and signal boundaries'
    $s=[IO.File]::ReadAllText($self)
    $m=[regex]::Match($s,'(?ms)^#HCR_ZIP_BEGIN\r?\n([A-Za-z0-9+/=\r\n]+)^#HCR_ZIP_END')
    if(-not $m.Success){throw 'Missing source ZIP'}
    $bytes=[Convert]::FromBase64String($m.Groups[1].Value)
    $hasher=[Security.Cryptography.SHA256]::Create()
    try {$actual=([BitConverter]::ToString($hasher.ComputeHash($bytes))).Replace('-','').ToLowerInvariant()}
    finally {$hasher.Dispose()}
    if($actual -ne '0a060249e99d883bb061fb114b9a220295db819a18869e8ce6127b54fdf52371'){throw 'Embedded ZIP checksum mismatch'}
    $archive=Join-Path $journal 'payload.zip'
    [IO.File]::WriteAllBytes($archive,$bytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $z=[IO.Compression.ZipFile]::OpenRead($archive)
    try {
        foreach($name in @('scripts/r049_install.py','scripts/r049_launch.ps1')) {
            $e=$z.GetEntry($name)
            if($null -eq $e){throw ('Missing trusted entry: '+$name)}
            $reader=New-Object IO.StreamReader($e.Open(),[Text.Encoding]::UTF8)
            try {$text=$reader.ReadToEnd()} finally {$reader.Dispose()}
            [IO.File]::WriteAllText((Join-Path $journal ([IO.Path]::GetFileName($name))),$text,(New-Object Text.UTF8Encoding($false)))
        }
    }finally{$z.Dispose()}
    [IO.File]::WriteAllText((Join-Path $journal 'package_sha256.txt'),$actual,(New-Object Text.UTF8Encoding($false)))
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $journal 'r049_launch.ps1') -Repo $repo -Archive $archive
    $code=$LASTEXITCODE
    if($null -eq $code){$code=1}
    [IO.File]::WriteAllText((Join-Path $journal 'exit_code.txt'),[string]$code,(New-Object Text.UTF8Encoding($false)))
}catch{
    Write-Host ('ERROR: '+$_.Exception.Message)
    if($journal){[IO.File]::WriteAllText((Join-Path $journal 'failure.txt'),($_|Out-String),(New-Object Text.UTF8Encoding($false)))}
    $code=1
}
exit $code
#HCR_PS_END

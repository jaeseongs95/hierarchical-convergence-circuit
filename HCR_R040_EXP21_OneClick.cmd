@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "HCR_R040_LAUNCHER=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:HCR_R040_LAUNCHER);$m=[regex]::Match($s,'(?ms)^#HCR_PS_BEGIN\r?\n(.*?)^#HCR_PS_END');if(-not $m.Success){throw 'Missing launcher section'};& ([scriptblock]::Create($m.Groups[1].Value))"
set "RC=%ERRORLEVEL%"
echo.
echo Exit code: %RC%
pause
exit /b %RC%
#HCR_PS_BEGIN
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding($false)
$OutputEncoding = [Console]::OutputEncoding
$code = 1
$tempDirectory = $null
try {
    $selfPath = $env:HCR_R040_LAUNCHER
    $repo = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($selfPath))
    if (-not (Test-Path -LiteralPath (Join-Path $repo 'src\hcr') -PathType Container)) {
        throw 'Place this CMD file in the existing HCR project root.'
    }
    Write-Host 'HCR R0.4.0 / EXP-21: install and run'
    Write-Host ('Project: ' + $repo)
    $selfText = [IO.File]::ReadAllText($selfPath)
    $match = [regex]::Match($selfText, '(?ms)^#HCR_ZIP_BEGIN\r?\n([A-Za-z0-9+/=\r\n]+)^#HCR_ZIP_END')
    if (-not $match.Success) { throw 'Embedded ZIP section is missing or invalid.' }
    $bytes = [Convert]::FromBase64String($match.Groups[1].Value)
    $hash = [Security.Cryptography.SHA256]::Create()
    try { $actual = ([BitConverter]::ToString($hash.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
    finally { $hash.Dispose() }
    if ($actual -ne '9d8f7fde9b29982a81b393e276bb2636aeb5fe481c1ddff168736ca0626296a9') { throw 'Embedded ZIP checksum mismatch. No files installed.' }
    $tempDirectory = Join-Path ([IO.Path]::GetTempPath()) ('hcr-r040-payload-' + [Guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($tempDirectory) | Out-Null
    $zipPath = Join-Path $tempDirectory 'payload.zip'
    $bootstrapPath = Join-Path $tempDirectory 'bootstrap_r040.ps1'
    [IO.File]::WriteAllBytes($zipPath, $bytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $zip = [IO.Compression.ZipFile]::OpenRead($zipPath)
    try {
        $entry = $zip.GetEntry('scripts/bootstrap_r040.ps1')
        if ($null -eq $entry) { throw 'Bootstrap script is missing from the verified archive.' }
        $reader = New-Object IO.StreamReader($entry.Open(), [Text.Encoding]::UTF8)
        try { [IO.File]::WriteAllText($bootstrapPath, $reader.ReadToEnd(), (New-Object Text.UTF8Encoding($false))) }
        finally { $reader.Dispose() }
    } finally { $zip.Dispose() }
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $bootstrapPath -Repo $repo -InstallArchive $zipPath
    $code = $LASTEXITCODE
    if ($null -eq $code) { $code = 1 }
} catch {
    Write-Host ('ERROR: ' + $_.Exception.Message) -ForegroundColor Red
    if ($null -eq $code -or $code -eq 0) { $code = 1 }
} finally {
    if ($tempDirectory -and (Test-Path -LiteralPath $tempDirectory)) {
        try { Remove-Item -LiteralPath $tempDirectory -Recurse -Force -ErrorAction Stop }
        catch { Write-Warning ('Temporary payload could not be removed: ' + $tempDirectory) }
    }
}
exit $code
#HCR_PS_END

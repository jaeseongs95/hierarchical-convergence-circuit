@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "HCR_R045_HF1=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:HCR_R045_HF1);$m=[regex]::Match($s,'(?ms)^#HCR_PS_BEGIN\r?\n(.*?)^#HCR_PS_END');if(-not $m.Success){throw 'Missing launcher section'};& ([scriptblock]::Create($m.Groups[1].Value))"
set "RC=%ERRORLEVEL%"
echo.
echo Exit code: %RC%
pause
exit /b %RC%
#HCR_PS_BEGIN
$ErrorActionPreference='Stop'
[Console]::OutputEncoding=New-Object Text.UTF8Encoding($false)
$OutputEncoding=[Console]::OutputEncoding
$code=1;$temp=$null
try {
  $self=$env:HCR_R045_HF1;$repo=[IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($self))
  if(-not (Test-Path -LiteralPath (Join-Path $repo 'src\hcr') -PathType Container)){throw 'Place this CMD in the HCR repository root.'}
  Write-Host 'HCR R045 / EXP-26 HF2: launcher regex fix + seed-schema validation fix + rerun'
  $txt=[IO.File]::ReadAllText($self);$m=[regex]::Match($txt,'(?ms)^#HCR_ZIP_BEGIN\r?\n([A-Za-z0-9+/=\r\n]+)^#HCR_ZIP_END')
  if(-not $m.Success){throw 'Embedded HF1 payload missing'}
  $bytes=[Convert]::FromBase64String($m.Groups[1].Value)
  $sha=[Security.Cryptography.SHA256]::Create();try{$actual=([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').ToLowerInvariant()}finally{$sha.Dispose()}
  if($actual -ne '139036232dcac4ffaa6e67b11f7abe20fbd4e7d39e72b63e756707f43c1e68c8'){throw 'HF1 payload checksum mismatch'}
  $temp=Join-Path ([IO.Path]::GetTempPath()) ('hcr-r045-hf1-'+[Guid]::NewGuid().ToString('N'));[IO.Directory]::CreateDirectory($temp)|Out-Null
  $zip=Join-Path $temp 'hf1.zip';[IO.File]::WriteAllBytes($zip,$bytes)
  Add-Type -AssemblyName System.IO.Compression.FileSystem;[IO.Compression.ZipFile]::ExtractToDirectory($zip,(Join-Path $temp 'payload'))
  $candidates=@();if($env:HCR_PYTHON){$candidates+=$env:HCR_PYTHON};$candidates+=(Join-Path $repo '.venv\Scripts\python.exe')
  foreach($v in @('312','313','314')){if($env:LOCALAPPDATA){$candidates+=(Join-Path $env:LOCALAPPDATA ('Programs\Python\Python'+$v+'\python.exe'))}}
  $p=Get-Command python.exe -ErrorAction SilentlyContinue;if($p -and $p.Source -and $p.Source.IndexOf('\WindowsApps\',[StringComparison]::OrdinalIgnoreCase) -lt 0){$candidates+=$p.Source}
  $py=$null;foreach($x in ($candidates|Select-Object -Unique)){if(Test-Path -LiteralPath $x -PathType Leaf){& $x -c 'import sys;sys.exit(0 if sys.version_info >= (3,12) else 1)' *> $null;if($LASTEXITCODE -eq 0){$py=$x;break}}}
  if($null -eq $py){throw 'Installed Python 3.12+ not found'}
  $env:PYTHONUTF8='1';$env:PYTHONIOENCODING='utf-8';$env:PYTHONDONTWRITEBYTECODE='1'
  & $py -X utf8 -B (Join-Path $temp 'payload\scripts\apply_r045_hf1.py') --repo $repo --payload (Join-Path $temp 'payload')
  if($LASTEXITCODE -ne 0){throw 'HF1 patch failed; original failure evidence was preserved.'}
  Write-Host 'HF2 launcher passed; HF1 seed-schema patch applied. Starting a NEW EXP-26 run; the failed run is not overwritten.'
  & $py -X utf8 -B -u (Join-Path $repo 'Run-HCR-R045.py')
  $code=$LASTEXITCODE;if($null -eq $code){$code=1}
} catch {Write-Host ('ERROR: '+$_.Exception.Message) -ForegroundColor Red;if($null -eq $code -or $code -eq 0){$code=1}} finally {if($temp -and (Test-Path -LiteralPath $temp)){Remove-Item -LiteralPath $temp -Recurse -Force -ErrorAction SilentlyContinue}}
exit $code
#HCR_PS_END

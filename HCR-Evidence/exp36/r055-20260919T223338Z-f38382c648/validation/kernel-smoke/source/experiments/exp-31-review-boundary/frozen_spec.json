  "predictions": [
    {
      "id": "P1",
      "claim": "Same-input restart should preserve the numeric solution under deterministic frozen inputs.",
      "failure_is": "numeric trajectory difference, not automatically an implementation error"
    },
    {
      "id": "P2",
      "claim": "Echo/revision-only restart should not change numeric state relative to same-input restart.",
      "failure_is": "revision/identity-sensitive numeric difference to investigate"
    },
    {
      "id": "P3",
      "claim": "A single sign-preserving strength intervention may change state or adopted output relative to the echo arm.",
      "failure_is": "no change is an informative negative result, not a reason to add more probes"
    },
    {
      "id": "P4",
      "claim": "Native observe_first can have no measurement target at a weak known-score rejection.",
      "failure_is": "a different native action is recorded, not corrected"
    }

@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "HCR_R047_SELF=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:HCR_R047_SELF);$m=[regex]::Match($s,'(?ms)^#HCR_PS_BEGIN\r?\n(.*?)^#HCR_PS_END');if(-not $m.Success){throw 'Missing launcher section'};& ([scriptblock]::Create($m.Groups[1].Value))"
set "RC=%ERRORLEVEL%"
echo.
echo Exit code: %RC%
pause
exit /b %RC%
#HCR_PS_BEGIN
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = New-Object Text.UTF8Encoding($false)
$OutputEncoding = [Console]::OutputEncoding
$code = 1
$log = $null
try {
    $self = $env:HCR_R047_SELF
    $repo = [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($self))
    if (-not (Test-Path -LiteralPath (Join-Path $repo 'src\hcr') -PathType Container)) {
        throw 'Place this CMD in the existing HCR repository root.'
    }
    $folder = Join-Path $repo ('HCR-Evidence\deployments\r047-bootstrap-' + [Guid]::NewGuid().ToString('N'))
    [IO.Directory]::CreateDirectory($folder) | Out-Null
    $log = Join-Path $folder 'bootstrap.txt'
    'HCR R047 / EXP28: state-component ablation' | Set-Content -LiteralPath $log -Encoding UTF8
    Write-Host 'HCR R047 / EXP28: state-component ablation'
    $s = [IO.File]::ReadAllText($self)
    $m = [regex]::Match($s, '(?ms)^#HCR_ZIP_BEGIN\r?\n([A-Za-z0-9+/=\r\n]+)^#HCR_ZIP_END')
    if (-not $m.Success) { throw 'Missing embedded source ZIP' }
    $bytes = [Convert]::FromBase64String($m.Groups[1].Value)
    $algorithm = [Security.Cryptography.SHA256]::Create()
    try { $actual = ([BitConverter]::ToString($algorithm.ComputeHash($bytes))).Replace('-','').ToLowerInvariant() }
    finally { $algorithm.Dispose() }
    if ($actual -ne '555f8ad13eb148bb387498c5f1367a687fbb5a61d93d567d2e1d48bc271f617e') { throw 'Embedded ZIP checksum mismatch' }
    $archive = Join-Path $folder 'payload.zip'
    [IO.File]::WriteAllBytes($archive,$bytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $z = [IO.Compression.ZipFile]::OpenRead($archive)
    try {
        foreach ($name in @('scripts/install_r047.py','scripts/launch_r047.ps1')) {
            $entry = $z.GetEntry($name)
            if ($null -eq $entry) { throw ('Missing verified entry: ' + $name) }
            $reader = New-Object IO.StreamReader($entry.Open(),[Text.Encoding]::UTF8)
            try { $text = $reader.ReadToEnd() } finally { $reader.Dispose() }
            [IO.File]::WriteAllText((Join-Path $folder ([IO.Path]::GetFileName($name))),$text,(New-Object Text.UTF8Encoding($false)))
        }
    } finally { $z.Dispose() }
    ('payload_sha256=' + $actual) | Add-Content -LiteralPath $log -Encoding UTF8
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $folder 'launch_r047.ps1') -Repo $repo -Archive $archive
    $code = $LASTEXITCODE
    if ($null -eq $code) { $code = 1 }
    ('exit_code=' + $code) | Add-Content -LiteralPath $log -Encoding UTF8
} catch {
    $message = 'ERROR: ' + $_.Exception.Message
    Write-Host $message
    if ($log) { $message | Add-Content -LiteralPath $log -Encoding UTF8 }
    $code = 1
}
exit $code
#HCR_PS_END
